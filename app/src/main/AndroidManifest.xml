<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Hardware this app can run without. Google Play hides an app from every device that lacks a
        feature the manifest requires, and several of our permissions imply one when it is not
        stated (CAMERA implies a camera and autofocus, ACCESS_WIFI_STATE implies Wi-Fi), so each is
        declared here as optional. That is what keeps the app installable on a Chromebook, which may
        have no rear camera, no Wi-Fi radio (Ethernet) or, in tablet mode and desktop mode, no
        touchscreen at all: it is driven by a keyboard and a mouse or trackpad, and every screen
        works that way (see docs/ADAPTIVE.md, "ChromeOS and desktop windowing").
    -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />
    <!-- A Chromebook is landscape and the window is freely resizable: no orientation is required. -->
    <uses-feature
        android:name="android.hardware.screen.portrait"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.screen.landscape"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        Only ever used to scan a relay's pairing QR, and requested at the moment Scan is tapped.
        Declared `required="false"` so a device without a camera can still install: typing the
        pairing code is a complete alternative, not a degraded one.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.front"
        android:required="false" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!--
        Haptic feedback. A normal permission, granted at install with no prompt. Without it the app
        could only ask the system to play a stock touch effect; with it the app plays its own, chosen
        for what the phone's motor can do (see HapticEngine). Vibration is always played as touch
        feedback, so it follows the phone's Touch feedback setting.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
        Defined by Termux, not by Android: it lets this app run a command inside Termux, which is
        how "this phone" mode starts and stops a harness on the device. Termux declares it
        `dangerous`, so the system asks the user, and the app only asks at the moment Start,
        Stop or Install is tapped — never on launch. Meaningless on a phone without Termux.
    -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!--
        Package visibility (API 30+): without this the app cannot see whether Termux is installed,
        cannot resolve its command service, and "this phone" mode would look broken only on real
        devices. Termux is the only package named; nothing else is queried.
    -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:name=".DshApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.DshMobile"
        tools:targetApi="35">

        <!--
            `configChanges` handles the locale itself rather than being torn down for it.

            Applying a language is a configuration change, and the default response is to destroy
            and rebuild the activity. Between the two there is no window at all — not a window with
            the wrong background, none — so the screen goes to whatever is behind it, which is
            black. Declaring these two means the framework delivers `onConfigurationChanged`
            instead; Compose re-reads its resources and the text simply changes, with the transcript
            and scroll position kept. `layoutDirection` is listed with `locale` on purpose: without
            it, switching to Arabic or Urdu would still tear the activity down.

            The same reasoning covers the window itself. A fold or unfold, a rotation, a split-screen
            divider being dragged and a hardware keyboard being attached are configuration changes
            too, and on a foldable they arrive constantly. Letting the framework rebuild the
            activity for each would tear down the transcript's scroll position, an open sheet and
            the focused composer every time the device is folded. `orientation`, `screenSize`,
            `smallestScreenSize` and `screenLayout` are the window's size and shape; `keyboard`,
            `keyboardHidden` and `navigation` are what a tablet's keyboard dock toggles. The adaptive
            shell reads the new size from Compose and from WindowManager and lays itself out again
            in place. `density`, `uiMode` and `fontScale` are deliberately left out: a different
            density or night mode wants the activity rebuilt (the status bar style is set once in
            `onCreate`), and what the reader typed, which session is open and which panes are shown
            all survive that rebuild (see MainScreen and SessionStore).

            `resizeableActivity` is declared on the application, and no `screenOrientation` is
            pinned anywhere: Android 16 ignores both on large screens, and the app has to look right
            at any size it is given, including a half-width split-screen window.

            The `<layout>` element is what a freeform window (ChromeOS, Android desktop mode, a
            tablet's windowed apps) opens at and may be dragged down to. 900x700dp is a comfortable
            three-pane-capable window that fits a 1366x768 Chromebook with its shelf; the 320x360dp
            floor is the smallest the layout stays usable at (a one-line composer and a short
            transcript), so a window can be tiled into a quarter of the screen. The system never
            offers a window smaller than the floor. It has no effect on phones.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="locale|layoutDirection|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.DshMobile.Starting">
            <layout
                android:defaultWidth="900dp"
                android:defaultHeight="700dp"
                android:gravity="center"
                android:minWidth="320dp"
                android:minHeight="360dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="host"
                    android:pathPrefix="/"
                    android:scheme="dshmobile" />
            </intent-filter>
        </activity>

        <service
            android:name=".connection.ConnectionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            Where Termux reports a command's exit code and output. Not exported: the result travels
            in a PendingIntent this app minted, which executes with this app's own identity, so the
            receiver never has to be reachable from outside. Declared here rather than registered
            at runtime so a result arriving after the process was killed still lands — and a
            harness the app started can still be signed in to.
        -->
        <receiver
            android:name=".termux.TermuxResultReceiver"
            android:exported="false" />

        <!--
            Opts into AppCompat's own storage for the per-app language. Below API 33 the framework
            has no LocaleManager to remember the choice, and without this the library only holds it
            in memory: the app re-applies its saved tag on launch, but any AppCompat-managed context
            created before that read — including the windows dialogs and bottom sheets are drawn in
            — comes up in the device language instead. Disabled on purpose: it is a metadata holder,
            never started.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
