    <string name="ua_slot_sidebar_footer">সাইডবারের নিচের বোতাম</string>
    <string name="ua_slot_other">harness-এর অন্য কোথাও</string>
    <string name="ua_place_none">এটির জায়গা শুধু কম্পিউটারে আছে।</string>
    <string name="ua_empty">এখনো কোনো অ্যাড-অন নেই। প্লাগইন ইনস্টল করে harness-এর ওয়েব পেজ একবার খুললে এগুলো এখানে দেখা যাবে।</string>
    <string name="ua_off_notice">এই ফোনে অ্যাড-অন লুকানো আছে। এখানে যা বেছে নেবেন, কম্পিউটারে তা তবুও খাটে।</string>
    <string name="ua_read_only">harness এই সেটিংস শুধু পড়ার জন্য রাখে, তাই এখান থেকে বদলানো যাবে না।</string>
    <string name="ua_missing">harness-এ আর dsh-ui-sync প্লাগইন নেই।</string>
    <string name="ua_refresh_failed">রিফ্রেশ করা যায়নি। আগে যা লোড হয়েছিল তা-ই দেখানো হচ্ছে।</string>
    <string name="ua_err_conflict">একই সময়ে অন্য কেউ এই সেটিংস বদলেছে। আবার চেষ্টা করুন।</string>
    <string name="ua_err_rejected">harness এই পরিবর্তন নেয়নি।</string>
    <string name="ua_err_unreachable">harness-এর সঙ্গে যোগাযোগ করা যায়নি। কিছুই সেভ হয়নি।</string>
    <string name="ua_err_unavailable">এই সংযোগ থেকে অ্যাড-অন বদলানো যায় না।</string>
