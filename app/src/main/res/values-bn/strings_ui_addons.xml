    <string name="ua_title">অ্যাড-অন</string>
    <string name="ua_entry">প্রতিটি অ্যাড-অন কোথায় দেখাবে বেছে নিন</string>
    <string name="ua_switch">প্লাগইনের অ্যাড-অন দেখান</string>
    <string name="ua_switch_hint">চ্যাটের ওপরে harness প্লাগইনের জিনিস দেখায়, যেমন একটি পোষা প্রাণী বা বাড়তি বোতাম। চ্যাট খোলা থাকলে প্রায় 250 MB মেমরি নেয়।</string>
    <string name="ua_switch_low_memory">এই ফোনে 6 GB-এর কম মেমরি আছে, তাই শুরুতে এটি বন্ধ থাকে।</string>
    <string name="ua_intro">প্রতিটি জিনিস কোথায় দেখাবে বেছে নিন। harness আপনার পছন্দ রেখে দেয়, তাই কম্পিউটারেও সেটাই মানা হয়।</string>
