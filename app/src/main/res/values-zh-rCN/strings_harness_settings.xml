    <string name="hs_f_search_api">使用 Search API</string>
    <string name="hs_f_search_api_hint">关闭时，搜索通过 DeepSeek Messages 进行。开启后使用 Search 和 Fetch API，它们有各自的功能和定价。</string>
    <string name="hs_f_endpoint_messages">Messages API 地址</string>
    <string name="hs_f_endpoint_messages_hint">请包含 API 前缀，例如 %1$s。</string>
    <string name="hs_f_endpoint_search">Search 和 Fetch API 地址</string>
    <string name="hs_f_endpoint_search_hint">请包含 API 前缀，例如 %1$s。</string>
    <string name="hs_f_max_uses">每次请求的搜索次数</string>
    <string name="hs_f_max_uses_hint">辅助模型在一次请求中最多可以搜索几次。仅适用于通过 Messages 的搜索。</string>
    <string name="hs_f_count">每次搜索的结果数</string>
    <string name="hs_f_count_hint">每次查询返回多少条结果，范围 1 到 50。它不限制搜索的次数。</string>
    <string name="hs_key_unset">还没有设置密钥。只有使用 DeepSeek 账号模型的对话才能搜索，并且走默认地址。</string>
    <string name="hs_key_hint">保存在 harness 上，不会写入它的设置文件。留空表示保留当前密钥。</string>
    <string name="hs_key_remove_title">移除网页搜索的密钥？</string>
    <string name="hs_key_remove_body">harness 会忘记这个密钥。需要它的网页搜索会停止工作，直到你重新添加。</string>
    <string name="hs_key_shared">这个密钥是共用的。以下设置也在使用它：%1$s。在这里替换或移除，它们也会受到影响。</string>

