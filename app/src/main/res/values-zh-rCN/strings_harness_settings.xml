    <!-- Harness settings: the area in Settings and its pages. -->
    <string name="hs_title">harness 设置</string>
    <string name="hs_entry_summary">网页搜索、Shell 限制、子智能体等</string>
    <string name="hs_intro">harness 自己保存的设置，作用于你当前连接的 harness。</string>
    <string name="hs_section_more">更多设置</string>
    <string name="hs_empty">这个 harness 在这里没有可更改的设置。</string>
