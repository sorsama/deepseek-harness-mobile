<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#0B0C0F</color>

    <!--
        What the window paints when no content is drawn over it yet.

        It matches the Ink "Paper" `bgBase` in the light resources and the Ink dark `bgBase`
        (#0B0C0F) in values-night on purpose. Changing the app language recreates the activity, and
        a transparent window has nothing to show between the old Compose tree going away and the
        new one's first frame — which is where the flash came from. An opaque background of the
        right colour makes that gap invisible.
    -->
    <color name="window_background">#F7F6F2</color>
</resources>
